# MongoDB Atlas (production uses existing atlas database)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/authtodo

# Google OAuth (reuse existing credentials; set production redirect URI in production env)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://authtodo.dabelwal.online/api/auth/google/callback

# Access token JWT signing secret (generate a strong random secret for production)
ACCESS_TOKEN_SECRET=your_strong_random_access_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token expiration
REFRESH_TOKEN_EXPIRES_IN=7d
